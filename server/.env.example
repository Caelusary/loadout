# Leave MONGODB_URI empty in development to use a seeded in-memory database.
MONGODB_URI=
# In production the server refuses to start without MONGODB_URI, CLIENT_URL and a JWT_SECRET of 32+
# random characters (see src/env.js). On Render it runs in production mode even without NODE_ENV,
# but set NODE_ENV=production there anyway.
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Local API port (production uses the PORT your host sets)
API_PORT=5000
# 1 = trust the one proxy in front of the API (Render's). Higher values let direct callers fake their IP.
TRUST_PROXY=1

# Optional. Without these, uploads are stored in server/uploads and served from /api/files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed accounts (all use the password: password123)
# owner@loadout.test, admin@loadout.test, northpaw@loadout.test, glide@loadout.test, hush@loadout.test,
# coilworks@loadout.test (pending seller), mika@loadout.test, paolo@loadout.test, lea@loadout.test

# Password reset emails (Brevo, free plan: brevo.com > SMTP & API > API keys). MAIL_FROM must be a
# sender you verified in Brevo. Without these, development prints reset links in this terminal.
BREVO_API_KEY=
MAIL_FROM=
